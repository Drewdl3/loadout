{
  "$id": "https://github.com/Drewdl3/loadout/schemas/cli/secrets-check.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SecretsCheckReport",
  "description": "`--json` output of `lo secrets check`.",
  "type": "object",
  "properties": {
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RefCheck"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "references",
    "warnings"
  ],
  "$defs": {
    "RefCheck": {
      "type": "object",
      "properties": {
        "reference": {
          "description": "The reference, e.g. `secret://jira/token`.",
          "type": "string"
        },
        "items": {
          "description": "Items using it.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "$ref": "#/$defs/RefStatus"
        },
        "detail": {
          "description": "Why it didn't resolve (never the value).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "reference",
        "items",
        "status"
      ]
    },
    "RefStatus": {
      "type": "string",
      "enum": [
        "ok",
        "missing",
        "error"
      ]
    }
  }
}
