{
  "$id": "https://github.com/Drewdl3/loadout/schemas/cli/diff.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiffReport",
  "description": "`--json` output of `lo diff`.",
  "type": "object",
  "properties": {
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiffEntry"
      }
    }
  },
  "required": [
    "changes"
  ],
  "$defs": {
    "DiffEntry": {
      "description": "A fetched change waiting for review.",
      "type": "object",
      "properties": {
        "source": {
          "description": "Source id from its `LOADOUT.md`.",
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "layer": {
          "type": "string"
        },
        "from": {
          "description": "Applied commit; absent for a source that isn't installed yet.",
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "description": "Fetched commit waiting for approval.",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/Reason"
        },
        "items": {
          "$ref": "#/$defs/ItemChanges"
        },
        "findings": {
          "description": "Audit findings on the changed items.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FindingRecord"
          },
          "default": []
        },
        "diff": {
          "description": "`git diff` of the source repo between the applied and pending\ncommits.",
          "type": "string"
        }
      },
      "required": [
        "source",
        "url",
        "layer",
        "to",
        "reason",
        "items",
        "diff"
      ]
    },
    "Reason": {
      "description": "Why a change was not applied.",
      "oneOf": [
        {
          "description": "The source's layer is not in `auto_apply`.",
          "type": "string",
          "const": "review"
        },
        {
          "description": "Manual subscriptions are never auto-applied.",
          "type": "string",
          "const": "manual-source"
        },
        {
          "description": "The audit found `high` issues.",
          "type": "string",
          "const": "audit"
        },
        {
          "description": "The audit found `critical` issues; approving needs `--force-audit`.",
          "type": "string",
          "const": "blocked"
        }
      ]
    },
    "ItemChanges": {
      "description": "Item-level summary of a change (`kind/name` keys).",
      "type": "object",
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "added",
        "removed",
        "changed"
      ]
    },
    "FindingRecord": {
      "description": "A stored audit finding (same fields as `lo audit --json`).",
      "type": "object",
      "properties": {
        "rule": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "message": {
          "type": "string"
        },
        "item": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "excerpt": {
          "type": "string"
        }
      },
      "required": [
        "rule",
        "severity",
        "message",
        "item",
        "file",
        "line",
        "excerpt"
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "info",
        "warn",
        "high",
        "critical"
      ]
    }
  }
}
