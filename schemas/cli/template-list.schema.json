{
  "$id": "https://github.com/Drewdl3/loadout/schemas/cli/template-list.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TemplateListReport",
  "description": "`--json` output of `lo template list`.",
  "type": "object",
  "properties": {
    "templates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TemplateEntry"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "templates",
    "warnings"
  ],
  "$defs": {
    "TemplateEntry": {
      "description": "One template, as listed.",
      "type": "object",
      "properties": {
        "id": {
          "description": "`source:template/name`.",
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "description": "What the template is for.",
          "type": [
            "string",
            "null"
          ]
        },
        "skill_description": {
          "description": "The description the generated skill gets (may use variables).",
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TemplateVar"
          }
        },
        "files": {
          "description": "Files, relative to the template directory.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_subscribed": {
          "description": "From a source you're not subscribed to (`--all-sources`).",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "source",
        "name",
        "tags",
        "variables",
        "files",
        "not_subscribed"
      ]
    },
    "TemplateVar": {
      "description": "One variable.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Used as `{{name}}` in the template's files.",
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "default": {
          "description": "Used when no value is given; a variable without one is required.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    }
  }
}
